# Deploy targets for scripts/deploy.sh. Copy to .env (gitignored) and fill in.
# Each target NAME in DEPLOY_TARGETS reads NAME_* settings (upper case).
DEPLOY_TARGETS="alpha beta"

# A host with versioned releases: DIR/releases/<commit>, DIR/current -> live.
ALPHA_SSH=alpha                         # ssh alias, from ~/.ssh/config
ALPHA_URL=https://game.example.com      # public URL, for the checks
ALPHA_PORT=8080                         # the server's loopback port on the host
ALPHA_LAYOUT=releases
ALPHA_DIR=/opt/parallax
# ALPHA_UNIT=parallax                   # systemd unit; parallax by default
# ALPHA_ARCH=arm64                      # arm64 (default) or amd64

# A host with one binary, the previous one kept as BIN.prev.
BETA_SSH=beta
BETA_URL=https://beta.example.net
BETA_PORT=8080
BETA_LAYOUT=single
BETA_BIN=/usr/local/bin/parallax
